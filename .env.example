# ============================================================
# UdyamAI — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# ============================================================

# ---- Supabase / PostgreSQL --------------------------------
# Get from: Supabase Dashboard ? Project Settings ? Database
DATABASE_URL=postgresql://postgres.[YOUR_PROJECT_ID]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://[YOUR_PROJECT_ID].supabase.co
SUPABASE_ANON_KEY=[YOUR_SUPABASE_ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR_SUPABASE_SERVICE_ROLE_KEY]

# ---- Google Gemini AI ------------------------------------
GOOGLE_GEMINI_API_KEY=[YOUR_GEMINI_API_KEY]
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=8192

# ---- Qdrant (Vector Store — local Docker) ----------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=udyamai_knowledge

# ---- Redis (Cache — local Docker) ------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_REPORT_TTL_SECONDS=3600
REDIS_LOCATION_TTL_SECONDS=86400

# ---- Ollama (bge-m3 Embeddings — local) ------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3

# ---- FastAPI Backend ------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
BACKEND_LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Frontend -------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=UdyamAI

# ---- Supabase Storage (for PDF reports) -----------------
SUPABASE_STORAGE_BUCKET=reports

# ---- Application Settings --------------------------------
APP_ENV=development
SECRET_KEY=[GENERATE_WITH: python -c "import secrets; print(secrets.token_hex(32))"]
